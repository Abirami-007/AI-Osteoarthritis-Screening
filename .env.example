# ─────────────────────────────────────────────
# KneeCare AI — Environment Variables
# AI-Assisted Early Osteoarthritis Risk Screening System
# ─────────────────────────────────────────────
# Copy this file to:
#   - `.env` for local development
#   - `.env.production` for production build (or set in deployment settings like Vercel/Netlify)
#
# Vite exposes only variables prefixed with VITE_ to client-side code.
# See: https://vite.dev/guide/env-and-mode

# Base URL for the FastAPI backend API (no trailing slash).
# Local development:
VITE_API_BASE_URL=http://127.0.0.1:8000
# Production deployment example:
# VITE_API_BASE_URL=https://your-backend.onrender.com

# Public URL of the deployed frontend app (used for QR code generation, etc.)
# If left empty, window.location.origin is used automatically.
VITE_APP_URL=

# ─────────────────────────────────────────────
# BLE (Bluetooth Low Energy) Configuration
# ─────────────────────────────────────────────
# These UUIDs must match the ESP32 firmware BLE service and characteristic.
# Default values are common ESP32 BLE examples.
# Change these to match YOUR ESP32 firmware configuration.

# ESP32 BLE Service UUID (the main sensor data service)
VITE_BLE_SERVICE_UUID=4fafc201-1fb5-459e-8fcc-c5c9c331914b

# ESP32 BLE Characteristic UUID (the sensor data notification characteristic)
VITE_BLE_CHARACTERISTIC_UUID=beb5483e-36e1-4688-b7f5-ea07361b26a8
