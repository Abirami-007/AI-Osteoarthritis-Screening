# ─────────────────────────────────────────────
# OA Screening System — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to `.env` (local) or `.env.production` (production build)
# and fill in the values.
#
# Vite exposes only variables prefixed with VITE_ to client-side code.
# See: https://vite.dev/guide/env-and-mode

# Base URL for the backend API (no trailing slash)
# Leave empty if the app has no backend / uses mock data only.
VITE_API_BASE_URL=

# Public URL of the deployed app (used for QR code generation, etc.)
# If left empty, window.location.origin is used automatically.
VITE_APP_URL=
