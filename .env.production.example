# ─────────────────────────────────────────────
# KneeCare AI — Production Environment Variables
# AI-Assisted Early Osteoarthritis Risk Screening System
# ─────────────────────────────────────────────
# Set these environment variables in your frontend hosting dashboard
# (e.g., Vercel, Netlify, Cloudflare Pages, AWS Amplify)
# or copy to .env.production before running `npm run build`.

# Production FastAPI backend URL (HTTPS, no trailing slash)
# Replace with your deployed backend URL:
VITE_API_BASE_URL=https://your-kneecare-backend.onrender.com

# Public URL of your deployed frontend (e.g., https://kneecare.vercel.app)
VITE_APP_URL=https://your-kneecare-app.vercel.app

# ESP32 BLE Configuration
VITE_BLE_SERVICE_UUID=4fafc201-1fb5-459e-8fcc-c5c9c331914b
VITE_BLE_CHARACTERISTIC_UUID=beb5483e-36e1-4688-b7f5-ea07361b26a8
