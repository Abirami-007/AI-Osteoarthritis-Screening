# ─────────────────────────────────────────────
# KneeCare AI Backend — Environment Variables
# ─────────────────────────────────────────────

# Allowed CORS origins for the FastAPI backend (comma-separated list).
# In production, set this to your deployed frontend domain(s).
# Example: https://kneecare-app.vercel.app,https://yourcustomdomain.com
# For open access / testing: *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173

# Port to bind (set automatically by platforms like Render, Railway, Heroku)
PORT=8000

# ─────────────────────────────────────────────
# PostgreSQL Database Connection (SQLAlchemy)
# ─────────────────────────────────────────────
# Set your PostgreSQL connection string here.
# KneeCare AI connects via SQLAlchemy and automatically creates the required tables
# (users, patients, screenings) upon startup if this variable is provided.
#
# Local PostgreSQL example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/kneecare_ai
#
# Cloud PostgreSQL (Supabase / Neon / Render / Railway) example:
# DATABASE_URL=postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Note: If DATABASE_URL is not set, database endpoints return HTTP 503,
# while the ML prediction (/predict, /model-info, /health) remains fully functional.
DATABASE_URL=
